NODE_ENV=development
APP_URL=http://127.0.0.1:43147

# PostgreSQL (required for Prisma; not used by /api/health)
DATABASE_URL=postgresql://klarsinn:klarsinn@127.0.0.1:5432/klarsinn?schema=public
DIRECT_URL=postgresql://klarsinn:klarsinn@127.0.0.1:5432/klarsinn?schema=public

# Phase 1 — database sessions (required in production)
AUTH_SECRET=replace-with-a-random-string-at-least-32-chars
AUTH_RATE_LIMIT_PER_MINUTE=10
SESSION_TTL_DAYS=30

# Phase 3 — Gemini behind AIProvider (leave unset until Gemini is implemented)
AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Storage — Phase 2 uses the private Supabase bucket
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=study-materials
LOCAL_STORAGE_DIR=./uploads

MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_PAGES=50
UNDERSTANDING_SCHEMA_VERSION=understanding.v1

DOCUMENT_JOB_CONCURRENCY=1
DOCUMENT_JOB_MAX_ATTEMPTS=3

AI_RATE_LIMIT_PER_MINUTE=6
UPLOAD_RATE_LIMIT_PER_HOUR=10
